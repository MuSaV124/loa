{
  "version": 2,
  "functions": {
    "api/**/*.js": {
      "maxDuration": 60
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/(?:index\\.html)?",
      "dest": "/public/index.html"
    },
    {
      "src": "/(?:simulator|market|ratios)/?",
      "dest": "/public/index.html"
    },
    {
      "src": "/character/[^/]+(?:/(?:nodes|combat))?/?",
      "dest": "/public/index.html"
    },
    {
      "src": "/(.+\\.[^/]+)",
      "dest": "/public/$1"
    },
    {
      "src": "/.*",
      "dest": "/public/index.html",
      "status": 404
    }
  ]
}
