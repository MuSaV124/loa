{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "api/**/*.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/character/:name", "destination": "/index.html" },
    { "source": "/character/:name/nodes", "destination": "/index.html" },
    { "source": "/character/:name/combat", "destination": "/index.html" },
    { "source": "/simulator", "destination": "/index.html" },
    { "source": "/market", "destination": "/index.html" },
    { "source": "/ratios", "destination": "/index.html" }
  ]
}
